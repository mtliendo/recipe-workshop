# Auth0 writes the real values to .env.local. Copy the names below when you set up a tenant.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# Pooled Neon connection string for the running app.
DATABASE_URL=

# Model IDs from https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_MODEL=google/gemini-3-flash
AI_GATEWAY_IMAGE_MODEL=google/gemini-3.1-flash-image-preview

# Created with the Vercel Blob store. On Vercel, OIDC can stand in for the gateway key.
BLOB_READ_WRITE_TOKEN=
AI_GATEWAY_API_KEY=
